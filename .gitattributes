# Fins de ligne normalisées (LF dans le dépôt).
* text=auto

# Lus sous Linux (image Docker, Render) : toujours LF.
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
render.yaml text eol=lf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.avif binary
*.woff binary
*.woff2 binary
*.pdf binary
